---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pageType?: 'WebPage' | 'CollectionPage';
  mainEntity?: Record<string, unknown>;
  structuredData?: Record<string, unknown>[];
}

const {
  title = 'Ship a Game | the real-world AI game benchmark',
  description = 'Frontier AI models research, build and improve real paid iOS games. Read the prompts, intervention scores and complete first-person reports.',
  pageType = 'WebPage',
  mainEntity,
  structuredData = [],
} = Astro.props;
// File output and slash aliases all identify the same clean public route.
const canonicalPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '')
  .replace(/\/$/, '') || '/';
const canonical = new URL(canonicalPath, Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;
const websiteId = `${siteUrl}#website`;
const publisherId = 'https://weevolve.app/#publisher';
const data = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': publisherId, name: 'WeEvolve', url: 'https://weevolve.app/' },
    { '@type': 'WebSite', '@id': websiteId, url: siteUrl, name: 'Ship a Game', publisher: { '@id': publisherId }, inLanguage: 'en' },
    { '@type': pageType, '@id': `${canonical}#webpage`, url: canonical, name: title, description, isPartOf: { '@id': websiteId }, publisher: { '@id': publisherId }, ...(mainEntity ? { mainEntity } : {}) },
    ...structuredData,
  ],
};
// Prevent content strings from closing the script element.
const structuredJson = JSON.stringify(data).replace(/</g, '\\u003c');

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101118" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={structuredJson} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Ship a Game home">
        <span class="brand-mark" aria-hidden="true">S</span>
        <span>Ship a Game</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/prompt">The challenge</a>
        <a href="/#games">Games</a>
        <a href="/#method">Method</a>
        <a href="/#pricing">Why paid?</a>
      </nav>
      <details class="mobile-menu">
        <summary>Menu</summary>
        <div>
          <a href="/prompt">The challenge</a>
          <a href="/#games">Games</a>
          <a href="/#method">Method</a>
          <a href="/#pricing">Why paid?</a>
          <a href="/feedback">Send feedback</a>
        </div>
      </details>
      <a class="header-cta" href="/feedback">Send feedback</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div>
        <a class="brand footer-brand" href="/">
          <span class="brand-mark" aria-hidden="true">S</span>
          <span>Ship a Game</span>
        </a>
        <p>A curious, independent benchmark from the WeEvolve family.</p>
      </div>
      <div class="footer-links">
        <a href="/prompt">The challenge</a>
        <a href="/#games">Games</a>
        <a href="/#method">Methodology</a>
        <a href="/feedback">Feedback</a>
      </div>
      <p class="fine-print">Two build rounds, one reporting round, and the receipts.</p>
    </footer>
  </body>
</html>
