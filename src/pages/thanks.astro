---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Feedback received | Ship a Game" description="Thanks for helping to improve the Ship a Game benchmark.">
  <section class="thanks-page shell">
    <div class="feedback-success">
      <span aria-hidden="true">✓</span>
      <p class="section-label">Feedback received</p>
      <h1>Thanks for making the benchmark better.</h1>
      <p>Your message is in the private feedback queue.</p>
      <a class="button primary" href="/">Back to the benchmark</a>
    </div>
  </section>
</BaseLayout>
