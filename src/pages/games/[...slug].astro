---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);
const d = game.data;
---

<BaseLayout title={`${d.title} | Ship a Game`} description={d.summary}>
  <article class="article">
    <header class="article-hero shell">
      <a class="back-link" href="/#games">← All games</a>
      <div class="article-title-grid">
        <div>
          <p class="kicker"><span class="live-dot"></span> {d.statusLabel} · {d.model} · {d.harness}</p>
          <h1>{d.title}</h1>
          <p class="article-summary">{d.summary}</p>
        </div>
        <div class="article-score" style={`--game-cover: url("${d.coverImage}")`}>
          <img src={d.coverImage} alt={d.coverAlt} />
          <small>ROUND 1 AUTONOMY</small>
          <strong>{d.autonomyScore}</strong>
          <span>{d.interventions} intervention{d.interventions === 1 ? '' : 's'}</span>
        </div>
      </div>
      <dl class="article-facts">
        <div><dt>Model</dt><dd>{d.model}</dd></div>
        <div><dt>Harness</dt><dd>{d.harness}</dd></div>
        <div><dt>Engine</dt><dd>{d.engine}</dd></div>
        <div><dt>Apple review</dt><dd>{d.appleOutcome}</dd></div>
        <div><dt>Time / cost</dt><dd>{d.timeToShip ?? 'Not recorded'} · {d.runCost ?? 'Not recorded'}</dd></div>
        <div><dt>Independent quality</dt><dd>{d.qualityRating ?? 'Not rated'}</dd></div>
      </dl>
      {d.protocolNote && (
        <aside class="protocol-disclosure">
          <span>PROTOCOL DISCLOSURE</span>
          <p>{d.protocolNote}</p>
        </aside>
      )}
      <section class="article-round-scorecard" aria-label="Three-round scorecard">
        <div><span>ROUND 1</span><b>{d.autonomyScore}</b><small>{d.interventions} intervention{d.interventions === 1 ? '' : 's'} · autonomy</small></div>
        <div><span>ROUND 2</span><b>{d.round2Score ?? 'Not reported'}</b><small>{d.round2Interventions ?? 'Not reported'} intervention{d.round2Interventions === 1 ? '' : 's'} · iteration{d.round2Model ? ` · ${d.round2Model}` : ''}</small></div>
        <div><span>ROUND 3</span><b>{d.round3Score ?? 'Not reported'}</b><small>{d.round3Interventions ?? 'Not reported'} intervention{d.round3Interventions === 1 ? '' : 's'} · storytelling</small></div>
      </section>
      <section class="article-playtest" aria-label="Human playtest result">
        <span>HUMAN FUN CHECK</span>
        <strong>{d.playtestVerdict}</strong>
        <small>{d.extraPrompts} extra quality-gate prompt{d.extraPrompts === 1 ? '' : 's'} recorded</small>
      </section>
    </header>

    {d.screenshots.length > 0 && (
      <div class="screenshot-rail shell">
        {d.screenshots.map((src, index) => <figure><img src={src} alt={`${d.title} gameplay screenshot ${index + 1}`} loading="lazy" /></figure>)}
      </div>
    )}

    <div class="article-body shell">
      <aside>
        <p class="section-label">Run data</p>
        <div><span>Release</span><b>{d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</b></div>
        <div><span>Price</span><b>{d.price}</b></div>
        <a class="button primary" href={d.appStoreUrl} target="_blank" rel="noreferrer">Play on the App Store ↗</a>
        {d.sourceUrl && <a class="text-link" href={d.sourceUrl} target="_blank" rel="noreferrer">View source + support ↗</a>}
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
</BaseLayout>
