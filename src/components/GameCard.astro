---
interface Props {
  slug: string;
  title: string;
  model: string;
  engine: string;
  score: string;
  interventions: number;
  round2Score?: string;
  round3Score?: string;
  statusLabel: string;
  coverImage: string;
  coverAlt: string;
  summary: string;
}

const {
  slug,
  title,
  model,
  engine,
  score,
  interventions,
  round2Score,
  round3Score,
  statusLabel,
  coverImage,
  coverAlt,
  summary,
} = Astro.props;
---

<article class="game-card">
  <a class="game-art" href={`/games/${slug}`} aria-label={`Read the ${title} benchmark report`}>
    <img src={coverImage} alt={coverAlt} loading="lazy" />
    <span class="game-status"><i aria-hidden="true"></i>{statusLabel}</span>
  </a>
  <div class="game-card-body">
    <div class="eyebrow-row">
      <span class="pill">{engine}</span>
      <span>{interventions} intervention{interventions === 1 ? '' : 's'}</span>
    </div>
    <h3><a href={`/games/${slug}`}>{title}</a></h3>
    <p>{summary}</p>
    <dl class="mini-stats">
      <div><dt>Model</dt><dd>{model}</dd></div>
      <div><dt>R1 · build</dt><dd>{score}</dd></div>
      <div><dt>R2 · improve</dt><dd>{round2Score ?? 'N/A'}</dd></div>
      <div><dt>R3 · report</dt><dd>{round3Score ?? 'N/A'}</dd></div>
    </dl>
    <a class="text-link" href={`/games/${slug}`}>Read the run <span aria-hidden="true">↗</span></a>
  </div>
</article>
